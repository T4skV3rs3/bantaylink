# PostgreSQL connection used by ingestion scripts and optional Vercel API routes.
DATABASE_URL=postgresql://user:password@host:5432/bantaylink

# Set to false only when your provider does not require TLS.
DATABASE_SSL=true

# Optional ingestion connection pool size.
DB_POOL_MAX=4


# OpenHalalan source ref. Prefer an exact 40-character commit SHA for pinned runs.
OPENHALALAN_REF=main

# DPWH listing adapter controls.
DPWH_PAGE_LIMIT=5000
DPWH_START_PAGE=1
DPWH_MAX_PAGES=1000

# Optional bounded source test.
BANTAYLINK_MAX_RECORDS=100

# Required only by the DPWH contract-detail adapter.
DPWH_CONTRACT_IDS=
# Optional comma-separated eFOI response URLs for explicit document ingestion.
DPWH_EFOI_URLS=
